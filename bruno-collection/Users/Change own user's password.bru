meta {
  name: Change own user's password
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "oldPassword": "minhaSenhaAntiga",
    "newPassword": "minhaNovaSenha"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
